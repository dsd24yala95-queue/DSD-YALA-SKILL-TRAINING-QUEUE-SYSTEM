                    { label: "à¸£à¸­à¸”à¸³à¹€à¸™à¸´à¸™à¸à¸²à¸£", value: pendingCount, icon: "fa-hourglass-half", color: "from-amber-400 to-orange-500" },
                    { label: "à¸¢à¸·à¸™à¸¢à¸±à¸™à¸™à¸±à¸”à¸«à¸¡à¸²à¸¢à¹à¸¥à¹‰à¸§", value: approvedCount, icon: "fa-calendar-check", color: "from-blue-500 to-indigo-600" },
                    { label: "à¹€à¸ªà¸£à¹‡à¸ˆà¸ªà¸´à¹‰à¸™", value: queues.filter(q => q.status === "completed" || q.status === "passed").length, icon: "fa-check-double", color: "from-emerald-400 to-teal-600" },
