                                    <th className="px-4 py-3.5 text-left text-xs font-bold text-slate-500 uppercase">à¸œà¸¹à¹‰à¸ˆà¸­à¸‡</th>
                                    <th className="px-4 py-3.5 text-left text-xs font-bold text-slate-500 uppercase hidden md:table-cell">à¸šà¸£à¸´à¸à¸²à¸£</th>
                                    <th className="px-4 py-3.5 text-left text-xs font-bold text-slate-500 uppercase hidden lg:table-cell">à¸§à¸±à¸™à¸™à¸±à¸”à¸«à¸¡à¸²à¸¢</th>
                                    <th className="px-4 py-3.5 text-left text-xs font-bold text-slate-500 uppercase">à¸ªà¸–à¸²à¸™à¸°</th>
                                    <th className="px-4 py-3.5 text-right text-xs font-bold text-slate-500 uppercase">à¸”à¸³à¹€à¸™à¸´à¸™à¸à¸²à¸£</th>
                                </tr>
                            </thead>
                            <tbody className="divide-y divide-slate-50">
                                {filtered.map((q, i) => {
