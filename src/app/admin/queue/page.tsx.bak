                    <option value="test">à¸—à¸”à¸ªà¸­à¸šà¸¡à¸²à¸•à¸£à¸à¸²à¸™</option>
                    <option value="training">à¸à¸¶à¸à¸­à¸šà¸£à¸¡</option>
                </select>
                <button
                    onClick={loadQueues}
