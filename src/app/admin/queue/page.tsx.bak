    testing: { label: "à¸à¸³à¸¥à¸±à¸‡à¸—à¸”à¸ªà¸­à¸š", cls: "bg-indigo-500/10 text-indigo-500 border-indigo-500/20" },
    completed: { label: "à¸œà¹ˆà¸²à¸™à¸à¸²à¸£à¸›à¸£à¸°à¹€à¸¡à¸´à¸™", cls: "bg-emerald-500/10 text-emerald-500 border-emerald-500/20" },
