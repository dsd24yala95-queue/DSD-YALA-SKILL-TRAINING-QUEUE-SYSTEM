                >
                    <option value="all">à¸—à¸¸à¸à¸ªà¸–à¸²à¸™à¸°</option>
                    <option value="pending">à¸£à¸­à¸”à¸³à¹€à¸™à¸´à¸™à¸à¸²à¸£</option>
                    <option value="approved">à¸¢à¸·à¸™à¸¢à¸±à¸™à¸™à¸±à¸”à¸«à¸¡à¸²à¸¢</option>
                    <option value="completed">à¸œà¹ˆà¸²à¸™à¸à¸²à¸£à¸›à¸£à¸°à¹€à¸¡à¸´à¸™</option>
                    <option value="failed">à¹„à¸¡à¹ˆà¸œà¹ˆà¸²à¸™</option>
                    <option value="cancelled">à¸¢à¸à¹€à¸¥à¸´à¸</option>
                </select>
                <select
                    value={filterType}
