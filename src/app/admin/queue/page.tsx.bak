    pending: { label: "à¸£à¸­à¸”à¸³à¹€à¸™à¸´à¸™à¸à¸²à¸£", cls: "bg-amber-500/10  text-amber-500  border-amber-500/20" },
    approved: { label: "à¸¢à¸·à¸™à¸¢à¸±à¸™à¸™à¸±à¸”à¸«à¸¡à¸²à¸¢", cls: "bg-blue-500/10   text-blue-500   border-blue-500/20" },
    confirmed: { label: "à¸¢à¸·à¸™à¸¢à¸±à¸™à¸™à¸±à¸”à¸«à¸¡à¸²à¸¢", cls: "bg-blue-500/10   text-blue-500   border-blue-500/20" },
    checked_in: { label: "à¸£à¸­à¸—à¸”à¸ªà¸­à¸šà¸«à¸™à¹‰à¸²à¸‡à¸²à¸™", cls: "bg-fuchsia-500/10 text-fuchsia-500 border-fuchsia-500/20" },
